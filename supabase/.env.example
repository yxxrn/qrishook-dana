# Salin ke .env.local lalu: supabase secrets set --env-file .env.local
# (SUPABASE_URL di-inject otomatis oleh runtime, tidak perlu di-set)
SERVICE_ROLE_KEY=eyJ...
QRIS_HOOK_SECRET=<secret sama dengan di app HP>
QRIS_BOT_TOKEN=<bot token>
TG_SECRET_TOKEN=<random hex, dipakai setWebhook secret_token>
QRIS_PUBLIC_URL=https://<PROJECT_REF>.supabase.co
